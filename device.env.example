# Copy to ~/.config/ull-esp/device.env (or point ULL_ESP_CONFIG at it).
# Every ull-esp project bakes these in at build time; a variable set in the
# environment wins for one build. Settings saved on a board win over them.

# Optional: without Wi-Fi settings a board with setup mode starts it.
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password
# ull-fleet server on your LAN (IPv4; no DNS)
FLEET_BASE_URL=http://192.168.1.10:3000
# Public key printed by `ull-fleet-sign keygen`; updates must be signed with its secret key
OTA_PUBLIC_KEY=<64 hex digits>
