# Optional: without Wi-Fi settings the board starts in setup mode, and settings
# saved from the setup page replace these.
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password
# ull-fleet server on your LAN (IPv4; no DNS)
FLEET_BASE_URL=http://192.168.1.10:3000
# Public key printed by `ull-fleet-sign keygen`; updates must be signed with its secret key
OTA_PUBLIC_KEY=<64 hex digits>
